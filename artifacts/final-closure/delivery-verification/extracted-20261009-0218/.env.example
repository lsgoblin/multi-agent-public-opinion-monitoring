# Day 3 Bailian Beijing adapter. Copy verified current list prices into local .env.
# Configuration alone does not enable calls; code must also pass enable_live=True
# and an explicit positive max_calls after separate user authorization.
DASHSCOPE_API_KEY=
RISKSHIELD_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

RISKSHIELD_DAY3_MODEL_NETIZEN=qwen-turbo
RISKSHIELD_DAY3_MODEL_CUSTOMER=qwen-turbo
RISKSHIELD_DAY3_MODEL_MEDIA=qwen-flash
RISKSHIELD_DAY3_MODEL_KOL=qwen-flash
RISKSHIELD_DAY3_MODEL_REGULATOR=qwen-flash

# Verified against the Beijing qwen-turbo page on 2026-10-06. Recheck before use.
RISKSHIELD_BAILIAN_TURBO_PRICE_VERSION=official-docs-2026-10-06-beijing
RISKSHIELD_BAILIAN_TURBO_INPUT_CNY_PER_MILLION=0.3
RISKSHIELD_BAILIAN_TURBO_CACHED_INPUT_CNY_PER_MILLION=0.06
RISKSHIELD_BAILIAN_TURBO_OUTPUT_CNY_PER_MILLION=0.6
# Conservative tokenizer-free bound for the full bounded Day 3 prompt,
# including retained messages and own memory through round 30.
RISKSHIELD_BAILIAN_TURBO_MAX_INPUT_TOKENS=8192
RISKSHIELD_BAILIAN_TURBO_MAX_OUTPUT_TOKENS=160

# Fill these from the current Beijing qwen-flash price page before its first run.
RISKSHIELD_BAILIAN_FLASH_PRICE_VERSION=
RISKSHIELD_BAILIAN_FLASH_INPUT_CNY_PER_MILLION=
RISKSHIELD_BAILIAN_FLASH_CACHED_INPUT_CNY_PER_MILLION=
RISKSHIELD_BAILIAN_FLASH_OUTPUT_CNY_PER_MILLION=
RISKSHIELD_BAILIAN_FLASH_MAX_INPUT_TOKENS=8192
RISKSHIELD_BAILIAN_FLASH_MAX_OUTPUT_TOKENS=256
